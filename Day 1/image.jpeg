					<style>
/* Modal */
#cecVideoModal {
  display: none;
  position: fixed;
  z-index: 10000;
  top: 0; left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.95);
}

/* Close button */
#cecVideoModal .close-btn {
  position: absolute;
  top: 20px;
  right: 30px;
  font-size: 32px;
  color: white;
  cursor: pointer;
  z-index: 10001;
}

/* Iframe (video box) */
#cecVideoModal iframe {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 80vw;
  height: 45vw;
  max-width: 960px;
  max-height: 540px;
  background: #000;
  border: none;
  z-index: 10001;
}

/* Trigger text */
#cecVideoTrigger {
  cursor: pointer;
  font-size: 20px;
  color: #fff;
  display: inline-block;
  margin: 20px 0;
  text-decoration: none;
  text-align: center;
  width: 100%;
}
#cecVideoTrigger:hover {
  opacity: 0.8;
}
</style>

<!-- Trigger -->
<h4 id="cecVideoTrigger">City Engineering College Campus Tour</h4>

<!-- Modal -->
<div id="cecVideoModal" onclick="cecHandleBackgroundClick(event)">
  <span class="close-btn" onclick="cecCloseVideo()">×</span>
  <iframe id="cecYtVideo" src="./image_files/saved_resource.html" allow="autoplay" allowfullscreen="" title="City Engineering College Campus Tour" data-gtm-yt-inspected-9="true"></iframe>
</div>

<script>
let cecScrollY = 0;

document.getElementById("cecVideoTrigger").onclick = function() {
  cecScrollY = window.scrollY;
  document.body.style.position = 'fixed';
  document.body.style.top = `-${cecScrollY}px`;
  document.getElementById("cecVideoModal").style.display = "block";
  // ✅ Updated video link
  document.getElementById("cecYtVideo").src = "https://www.youtube.com/embed/EhG9pHGQOX8?autoplay=1";
};

function cecCloseVideo() {
  document.getElementById("cecVideoModal").style.display = "none";
  document.getElementById("cecYtVideo").src = "";
  document.body.style.position = '';
  document.body.style.top = '';
  window.scrollTo(0, cecScrollY);
}

function cecHandleBackgroundClick(event) {
  if (event.target.id === "cecVideoModal") {
    cecCloseVideo();
  }
}
</script>
				</div>
				</div>
					</div>
		</div>
					</div>
		</section>
